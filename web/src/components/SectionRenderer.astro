---
import type {PreparedPageSection} from '../lib/pageContentPreparation'
import ImageGroupBlock from './blocks/ImageGroupBlock.astro'
import PortableTextBlock from './blocks/PortableTextBlock.astro'
import SpacerBlock from './blocks/SpacerBlock.astro'

interface Props {
  section: PreparedPageSection
}

const {section} = Astro.props as Props
---

<section id={section.sectionId} class="content-section" data-section-id={section.sectionId}>
  {section.content.map((block) => {
    if (block._type === 'portableTextBlock') {
      return <PortableTextBlock block={block} />
    }

    if (block._type === 'pageImageGroupBlock') {
      return <ImageGroupBlock block={block} />
    }

    if (block._type === 'pageSpacerBlock') {
      return <SpacerBlock block={block} />
    }

    return null
  })}
</section>

<style>
  .content-section {
    width: 100%;
    margin-bottom: 60px;
    padding-top: 60px;
  }

  .content-section:first-child {
    padding-top: 0;
  }

  .content-section > :global(.content-richtext),
  .content-section > :global(.content-image-group) {
    margin-top: 0;
    margin-bottom: 0;
  }
</style>
