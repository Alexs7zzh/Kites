---
import type {PreparedPageContentBlock} from '../../lib/pageContentPreparation'
import {renderPortableTextToHtml} from '../../lib/portableTextRender'

type PortableTextBlockType = Extract<PreparedPageContentBlock, {_type: 'portableTextBlock'}>

interface Props {
  block: PortableTextBlockType
}

const {block} = Astro.props as Props
const renderedHtml = renderPortableTextToHtml(block.body)
---

<div class="content-richtext" set:html={renderedHtml} />

<style>
  .content-richtext {
    margin: 18px 0;
    text-align: left;
  }

  .content-richtext :global(p),
  .content-richtext :global(h2),
  .content-richtext :global(h3),
  .content-richtext :global(blockquote) {
    margin: 0 0 1.2em;
  }

  .content-richtext :global(p:last-child),
  .content-richtext :global(blockquote:last-child),
  .content-richtext :global(h2:last-child),
  .content-richtext :global(h3:last-child) {
    margin-bottom: 0;
  }

  .content-richtext :global(h2),
  .content-richtext :global(h3) {
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: 0;
  }

  .content-richtext :global(h2:first-child:not(:last-child)),
  .content-richtext :global(h3:first-child:not(:last-child)) {
    margin-top: -8px;
    margin-bottom: calc(1.2em + 8px);
  }

  .content-richtext :global(blockquote) {
    padding-left: 0.8rem;
    border-left: 1px solid rgba(0, 0, 0, 0.35);
  }

  .content-richtext :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .content-richtext :global(code) {
    font-family: inherit;
    font-size: 0.95em;
    background: rgba(0, 0, 0, 0.08);
    padding: 0 0.25em;
  }
</style>
