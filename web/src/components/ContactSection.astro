---
import type {PreparedContactSection} from '../lib/pageContentPreparation'
import {renderPortableTextToHtml} from '../lib/portableTextRender'
import PictureAsset from './blocks/PictureAsset.astro'

interface Props {
  contact: PreparedContactSection
  turnstileSiteKey: string
}

const {contact, turnstileSiteKey} = Astro.props as Props
---

<section
  id={contact.sectionId}
  class="content-section content-section--contact"
  data-section-id={contact.sectionId}
>
  {(contact.bioText || contact.bioImage) && (
    <div class="contact-bio">
      {contact.bioText && (
        <div
          class="contact-bio-text content-richtext"
          set:html={renderPortableTextToHtml(contact.bioText.body)}
        />
      )}
      {contact.bioImage && <PictureAsset image={contact.bioImage} class="contact-bio-image" />}
    </div>
  )}
  {contact.form && (
    <div class="contact-block" data-contact-form-block>
      <p class="contact-heading">{contact.form.heading}</p>
      <form
        class="contact-form"
        data-contact-form
        data-form-action={contact.form.formAction}
        data-turnstile-site-key={turnstileSiteKey}
      >
        <label>Name <input type="text" name="name" required /></label>
        <label>Email <input type="email" name="email" required /></label>
        <label>Message <textarea name="message" rows="4" required></textarea></label>
        <button type="submit">Send</button>
        <div class="contact-turnstile" data-turnstile-wrapper hidden>
          <div data-turnstile-container></div>
        </div>
        <p class="contact-status" data-form-status hidden></p>
      </form>
    </div>
  )}
</section>

<style>
  .content-section {
    width: 100%;
    margin-bottom: 60px;
    padding-top: 60px;
  }

  .contact-bio {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-top: 20px;
    margin-bottom: 25px;
  }

  .contact-bio-text {
    order: 2;
    width: 100%;
    max-width: 450px;
    font-size: 9px;
    line-height: 1.7;
    text-align: left;
  }

  .contact-bio-text :global(p) {
    margin: 0;
  }

  :global(.contact-bio-image) {
    order: 1;
    width: 100%;
    max-width: 300px;
    height: auto;
    margin-bottom: 10px;
  }

  :global(.contact-bio-image img) {
    width: 100%;
    height: auto;
  }

  .contact-block {
    max-width: 520px;
    margin-top: 20px;
  }

  .contact-heading {
    margin: 0;
    font-size: inherit;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 400px;
    margin: 20px auto 0;
    font-family: inherit;
    font-size: 12px;
    text-align: left;
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: 6px 2px;
    border: none;
    border-bottom: 1px solid black;
    background: transparent;
    font-family: inherit;
    font-size: 12px;
    outline: none;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-bottom: 1px solid #444;
  }

  .contact-form button {
    align-self: flex-start;
    padding: 8px 18px;
    font-family: inherit;
    font-size: 12px;
    letter-spacing: 0.05em;
    background: transparent;
    border: 1px solid black;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .contact-form button:hover {
    background: black;
    color: white;
  }

  .contact-turnstile {
    margin-top: 4px;
  }

  .contact-status {
    margin: 0;
    font-size: 12px;
    line-height: 1.4;
  }

  .contact-status[data-status='ERROR'],
  .contact-status[data-status='TURNSTILE_CONFIG_ERROR'] {
    color: #a00;
  }

  .contact-status[data-status='SUCCESS'] {
    color: #1f5f2c;
  }

  @media (max-width: 1300px) {
    :global(.contact-bio-image) {
      width: 100%;
      max-width: 100%;
    }

    .contact-bio {
      gap: 20px;
      margin-bottom: 20px;
    }

    .contact-bio-text {
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }
  }

  @media (min-width: 1000px) {
    .contact-bio {
      flex-direction: row;
      align-items: flex-end;
      justify-content: flex-end;
      gap: 40px;
      margin-bottom: 20px;
    }

    :global(.contact-bio-image) {
      order: 2;
      flex: 0 0 300px;
      width: 300px;
      min-width: 300px;
      max-width: 300px;
      margin-right: calc((100% - 400px) / 2);
      margin-left: 0;
      margin-bottom: 0;
    }

    .contact-bio-text {
      order: 1;
      flex: 0 0 320px;
      width: 320px;
      min-width: 320px;
      max-width: 320px;
      text-align: left;
      margin: 0 20px 0 0;
    }
  }
</style>
