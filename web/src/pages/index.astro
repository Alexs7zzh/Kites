---
import {getImage} from 'astro:assets'
import {createClient} from '@sanity/client'
import PageShell from '../components/PageShell.astro'
import {prepareBackgroundImage} from '../lib/backgroundImagePreparation'
import backgroundSource from '../assets/2025-08-05-Background.jpg'
import {prepareOgImage} from '../lib/ogImagePreparation'
import {PAGE_CONTENT_QUERY} from '../lib/pageContentQuery'
import {preparePageContent} from '../lib/pageContentPreparation'
import {SANITY_API_VERSION, SANITY_USE_CDN} from '../lib/sanityConfig.js'

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? ''

function getRequiredEnv(name: string): string {
  const rawValue = import.meta.env[name]
  if (typeof rawValue !== 'string' || rawValue.trim() === '') {
    throw new Error(`Missing required environment variable: ${name}`)
  }
  return rawValue.trim()
}

function nonEmpty(value: unknown): string | null {
  if (typeof value !== 'string') {
    return null
  }

  const trimmedValue = value.trim()
  return trimmedValue === '' ? null : trimmedValue
}

function normalizeHandle(value: unknown): string | null {
  const handle = nonEmpty(value)
  if (!handle) {
    return null
  }

  const sanitizedHandle = handle.replace(/^@+/, '')
  if (!sanitizedHandle) {
    return null
  }

  return `@${sanitizedHandle}`
}

function handleToProfileUrl(value: unknown, baseUrl: string): string | null {
  const handle = normalizeHandle(value)
  if (!handle) {
    return null
  }

  return `${baseUrl}/${handle.slice(1)}`
}

function toRootUrl(value: string | URL | null | undefined): string | null {
  if (!value) {
    return null
  }

  try {
    return new URL('/', value).toString()
  } catch {
    return null
  }
}

function toAbsoluteUrl(value: string, base: string | null): string {
  try {
    return new URL(value).toString()
  } catch {
    if (!base) {
      return value
    }

    try {
      return new URL(value, base).toString()
    } catch {
      return value
    }
  }
}

const sanityProjectId = getRequiredEnv('PUBLIC_SANITY_PROJECT_ID')
const sanityDataset = getRequiredEnv('PUBLIC_SANITY_DATASET')

const client = createClient({
  projectId: sanityProjectId,
  dataset: sanityDataset,
  useCdn: SANITY_USE_CDN,
  apiVersion: SANITY_API_VERSION,
})

let siteSettings = null

try {
  const response = await client.fetch(PAGE_CONTENT_QUERY)
  siteSettings = response?.siteSettings ?? null
} catch (error) {
  const message = error instanceof Error ? error.message : String(error)
  console.error(`Failed to fetch content from Sanity: ${message}`)
}

const preparedPageContent = await preparePageContent(siteSettings, getImage)
const preparedBackgroundImage = await prepareBackgroundImage({
  src: backgroundSource,
  getImage,
})
const preparedOgImage = await prepareOgImage({
  image: siteSettings?.defaultOgImage ?? null,
  getImage,
  maxDimension: 1200,
})

const siteName = nonEmpty(siteSettings?.siteName)
const title = siteName ?? 'Kites'

const description = nonEmpty(siteSettings?.defaultDescription)
const canonical = toRootUrl(nonEmpty(siteSettings?.canonicalDomain))
const ogImage = preparedOgImage ? toAbsoluteUrl(preparedOgImage.src, canonical) : null
const twitterSite = normalizeHandle(siteSettings?.social?.xHandle)
const robots = 'index,follow'
const twitterCard = ogImage ? 'summary_large_image' : 'summary'
const twitterCreator = twitterSite
const ogLocale = 'en_US'
const ogImageAlt = nonEmpty(siteSettings?.defaultOgImage?.alt) ??
  (ogImage ? `${title} link preview image` : null)
const socialProfiles = [
  handleToProfileUrl(siteSettings?.social?.xHandle, 'https://x.com'),
  handleToProfileUrl(siteSettings?.social?.instagramHandle, 'https://www.instagram.com'),
].filter((value): value is string => Boolean(value))
const organizationId = canonical ? `${canonical}#organization` : '#organization'
const websiteId = canonical ? `${canonical}#website` : '#website'
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: title,
      ...(canonical ? {url: canonical} : {}),
      ...(ogImage ? {logo: ogImage} : {}),
      ...(socialProfiles.length > 0 ? {sameAs: socialProfiles} : {}),
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: title,
      inLanguage: 'en-US',
      ...(canonical ? {url: canonical} : {}),
      ...(description ? {description} : {}),
      publisher: {
        '@id': organizationId,
      },
    },
  ],
})
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="preload"
      href={preparedBackgroundImage.preload.href}
      as="image"
      type={preparedBackgroundImage.preload.type}
      imagesrcset={preparedBackgroundImage.preload.imageSrcSet}
      imagesizes={preparedBackgroundImage.preload.imageSizes}
      fetchpriority="high"
    />
    <link
      rel="preload"
      href="/fonts/VictorMono-Regular-Original.woff"
      as="font"
      type="font/woff"
      crossorigin
    />

    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {siteName && <meta property="og:site_name" content={siteName} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:secure_url" content={ogImage} />}
    {ogImage && <meta property="og:image:type" content="image/jpeg" />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {preparedOgImage && <meta property="og:image:width" content={String(preparedOgImage.width)} />}
    {preparedOgImage && <meta property="og:image:height" content={String(preparedOgImage.height)} />}

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    {twitterSite && <meta name="twitter:site" content={twitterSite} />}
    {twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
    <script is:inline type="application/ld+json" set:html={structuredData} />
  </head>
  <body>
    {preparedPageContent ? (
      <PageShell
        pageContent={preparedPageContent}
        turnstileSiteKey={turnstileSiteKey}
        backgroundImage={preparedBackgroundImage}
      />
    ) : (
      <main style="padding: 2rem; font-family: monospace;">
        Unable to load site content from Sanity.
      </main>
    )}
  </body>
</html>
