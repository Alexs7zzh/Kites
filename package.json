{
  "name": "kites-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:web": "pnpm -C web dev",
    "dev:studio": "pnpm -C studio dev",
    "build:web": "pnpm -C web build",
    "build:studio": "pnpm -C studio build",
    "lint": "pnpm -C web lint",
    "shopify:node": "node --env-file-if-exists=.env --env-file-if-exists=web/.env",
    "shopify:theme:check": "shopify theme check --path shopify",
    "shopify:theme:dev": "shopify theme dev --path shopify",
    "shopify:theme:push": "shopify theme push --path shopify --ignore config/settings_data.json",
    "shopify:migrate-content": "pnpm run shopify:node -- scripts/shopify/migrate-sanity-to-shopify.mjs",
    "shopify:migrate": "pnpm run shopify:migrate-content"
  }
}
