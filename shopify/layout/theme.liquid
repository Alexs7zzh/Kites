<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title | escape }}</title>
    {% liquid
      assign favicon_light_svg_url = ''
      assign favicon_dark_svg_url = ''
      assign favicon_png_url = ''
      assign apple_touch_icon_url = ''

      if settings.favicon_light_svg != blank
        assign favicon_light_svg_url = settings.favicon_light_svg | image_url: width: 64
      else
        assign favicon_light_svg_url = 'favicon-light.svg' | asset_url
      endif

      if settings.favicon_dark_svg != blank
        assign favicon_dark_svg_url = settings.favicon_dark_svg | image_url: width: 64
      else
        assign favicon_dark_svg_url = favicon_light_svg_url
      endif

      if settings.favicon_png != blank
        assign favicon_png_url = settings.favicon_png | image_url: width: 32, height: 32
      else
        assign favicon_png_url = 'favicon.ico' | asset_url
      endif

      if settings.apple_touch_icon != blank
        assign apple_touch_icon_url = settings.apple_touch_icon | image_url: width: 180, height: 180
      endif
    %}
    <link rel="icon" type="image/svg+xml" sizes="any" href="{{ favicon_light_svg_url }}">
    <link rel="icon" type="image/svg+xml" sizes="any" media="(prefers-color-scheme: light)" href="{{ favicon_light_svg_url }}">
    <link rel="icon" type="image/svg+xml" sizes="any" media="(prefers-color-scheme: dark)" href="{{ favicon_dark_svg_url }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ favicon_png_url }}">
    <link rel="shortcut icon" href="{{ favicon_png_url }}">
    {% if apple_touch_icon_url != blank %}
      <link rel="apple-touch-icon" sizes="180x180" href="{{ apple_touch_icon_url }}">
    {% endif %}
    {{ 'VictorMono-Regular.c6ba95eb.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">

    {% if page_description != blank %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <link rel="canonical" href="{{ canonical_url }}">
    <meta name="robots" content="index,follow">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title | escape }}">

    {% if page_description != blank %}
      <meta property="og:description" content="{{ page_description | escape }}">
      <meta name="twitter:description" content="{{ page_description | escape }}">
    {% endif %}

    {% if page_image %}
      <meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">
      <meta name="twitter:image" content="{{ page_image | image_url: width: 1200 }}">
    {% endif %}

    {{ content_for_header }}

    {% liquid
      assign same_as = ''
      if settings.social_x_handle != blank
        assign same_as = same_as | append: '"https://x.com/' | append: settings.social_x_handle | escape | append: '"'
      endif
      if settings.social_instagram_handle != blank
        if same_as != blank
          assign same_as = same_as | append: ','
        endif
        assign same_as = same_as | append: '"https://www.instagram.com/' | append: settings.social_instagram_handle | escape | append: '"'
      endif
    %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "{{ canonical_url }}#organization",
            "name": {{ shop.name | json }}{% if same_as != blank %},
            "sameAs": [{{ same_as }}]{% endif %}
          },
          {
            "@type": "WebSite",
            "@id": "{{ canonical_url }}#website",
            "name": {{ shop.name | json }},
            "url": {{ canonical_url | json }},
            "publisher": {
              "@id": "{{ canonical_url }}#organization"
            }{% if page_description != blank %},
            "description": {{ page_description | json }}{% endif %}
          }
        ]
      }
    </script>
  </head>
  {% liquid
    assign cart_feature_expiry_ts = '2026-04-15 00:00:00 +0900' | date: '%s' | plus: 0
    assign now_ts = 'now' | date: '%s' | plus: 0
    assign cart_feature_enabled = false

    if now_ts < cart_feature_expiry_ts
      assign cart_feature_enabled = true
    endif
  %}
  <body class="template-{{ template.name | handle }}">
    {% if template.name == 'index' %}
      {% liquid
        assign background_placeholder = settings.background_placeholder_color | default: '#e7e4df'
      %}
      <div class="magnetic-dango-root" data-page-shell style="--background-placeholder: {{ background_placeholder }};">
        <div class="magnetic-dango-background-layer" aria-hidden="true">
          {% if settings.background_image != blank %}
            {{
              settings.background_image
              | image_url: width: 1920
              | image_tag:
                class: 'magnetic-dango-background-image',
                widths: '640, 960, 1280, 1536, 1920',
                sizes: '(max-aspect-ratio: 1920/1140) 168.5vh, 100vw',
                loading: 'eager',
                fetchpriority: 'high',
                alt: ''
            }}
          {% else %}
            <img
              class="magnetic-dango-background-image"
              src="{{ 'background-default.jpg' | asset_url }}"
              alt=""
              width="1920"
              height="1140"
              loading="eager"
              fetchpriority="high"
            >
          {% endif %}
        </div>

        <div class="magnetic-dango-foreground-layer">
          <svg data-magnetic-svg viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true">
            <path
              data-metaball-path
              class="metaball-path"
              fill="transparent"
              stroke="rgba(0, 0, 0, 0.25)"
              stroke-width="0.5"
              vector-effect="non-scaling-stroke"
            ></path>
          </svg>

          <div class="site-logo" data-site-logo role="img" aria-label="{{ shop.name | escape }}">
            {% if settings.logo_image != blank %}
              {{
                settings.logo_image
                | image_url: width: 360
                | image_tag:
                  class: 'site-logo-image',
                  widths: '120, 240, 360',
                  sizes: '120px',
                  loading: 'eager',
                  alt: shop.name
              }}
            {% else %}
              {% render 'site-logo-svg' %}
            {% endif %}
          </div>

          <div class="left-nav" data-left-nav></div>
          {% if cart_feature_enabled %}
            {% render 'cart-link' %}
          {% endif %}

          <div class="scrollable-text-container" data-scroll-container>
            <div class="page-content-wrapper" data-content-wrapper>
              {{ content_for_layout }}
            </div>
          </div>
        </div>
      </div>
    {% else %}
      {{ content_for_layout }}
    {% endif %}
    <script src="{{ 'magnetic-dango-runtime.js' | asset_url }}" defer></script>
    {% if cart_feature_enabled %}
      <script src="{{ 'add-to-cart-block.js' | asset_url }}" defer></script>
      <script src="{{ 'cart-link-runtime.js' | asset_url }}" defer></script>
    {% endif %}
  </body>
</html>
