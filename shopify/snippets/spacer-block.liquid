{% liquid
  assign level = block.level.value | default: block.level | default: 1
  assign height = '29px'

  case level
    when 2
      assign height = '58px'
    when 3
      assign height = '72px'
    when 4
      assign height = '87px'
    when 5
      assign height = '104px'
    when 6
      assign height = '120px'
  endcase
%}

<div class="content-spacer" style="height: {{ height }};" aria-hidden="true"></div>
