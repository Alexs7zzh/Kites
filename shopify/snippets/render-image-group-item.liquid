{% liquid
  assign image_object = image.preview_image | default: image
  assign image_height = image_object.height | default: 1
  assign image_width = image_object.width | default: image_height
  assign image_ratio = image_width | times: 1000 | divided_by: image_height
  assign sizes = '(max-width: 769px) calc(65vw - 40px), (max-width: 999px) calc((55vw - 160px) * 0.5), calc(((55vw + 236px) - (80px + (80px + 236px))) * 0.5)'

  if layout == 'full'
    assign sizes = '(max-width: 769px) calc(65vw - 40px), (max-width: 999px) calc(55vw - 160px), calc((55vw + 236px) - (80px + (80px + 236px)))'
  endif
%}

<div
  class="content-image-group__item"
  data-image-count="{{ image_count }}"
  data-image-index="{{ image_index }}"
  style="--image-ratio: {{ image_ratio }}; --image-fill-factor: {{ width_fill_factor }};"
>
  {{
    image_object
    | image_url: width: 1600
    | image_tag:
      class: 'content-image-group__img',
      widths: '320, 480, 640, 768, 1024, 1440, 1600',
      sizes: sizes,
      loading: 'lazy',
      alt: image.alt | default: ''
  }}
</div>
