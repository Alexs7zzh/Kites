{% liquid
  assign images = blank
  assign caption_title = block.caption_title.value | default: block.caption_title
  assign caption_body = block.caption_body.value | default: block.caption_body
  assign first_image = blank
  assign second_image = blank
  assign third_image = blank
  assign fourth_image = blank
  assign image_count = 0

  if block.settings != blank
    assign first_image = block.settings.image_1
    assign second_image = block.settings.image_2
    assign third_image = block.settings.image_3
    assign fourth_image = block.settings.image_4

    assign caption_title = block.settings.caption_title
    assign caption_body = block.settings.caption_body

    if first_image != blank
      assign image_count = image_count | plus: 1
    endif
    if second_image != blank
      assign image_count = image_count | plus: 1
    endif
    if third_image != blank
      assign image_count = image_count | plus: 1
    endif
    if fourth_image != blank
      assign image_count = image_count | plus: 1
    endif
  else
    assign images = block.images.value
    if images == blank
      assign images = block.images
    endif
    assign image_count = images.size
  endif

  assign count_class = 'content-image-group--count-' | append: image_count
  assign width_fill_factor = '1'

  if image_count == 2
    assign width_fill_factor = '0.96'
  elsif image_count == 3
    assign width_fill_factor = '0.93'
  endif

  assign has_caption = false

  if layout == 'half'
    if caption_title != blank or caption_body != blank
      assign has_caption = true
    endif
  endif
%}

<div class="content-image-group content-image-group--{{ layout }} {{ count_class }}{% if has_caption %} content-image-group--has-caption{% endif %}">
  {% if has_caption %}
    <div class="content-image-group__caption">
      {% if caption_title != blank %}
        <p class="content-image-group__caption-title">{{ caption_title }}</p>
      {% endif %}
      {% if caption_body != blank %}
        <p class="content-image-group__caption-body">{{ caption_body | newline_to_br }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="content-image-group__media">
    {% if block.settings != blank %}
      {% assign image_index = 0 %}
      {% if first_image != blank %}
        {% render 'render-image-group-item', image: first_image, image_count: image_count, image_index: image_index, layout: layout, width_fill_factor: width_fill_factor %}
        {% assign image_index = image_index | plus: 1 %}
      {% endif %}
      {% if second_image != blank %}
        {% render 'render-image-group-item', image: second_image, image_count: image_count, image_index: image_index, layout: layout, width_fill_factor: width_fill_factor %}
        {% assign image_index = image_index | plus: 1 %}
      {% endif %}
      {% if third_image != blank %}
        {% render 'render-image-group-item', image: third_image, image_count: image_count, image_index: image_index, layout: layout, width_fill_factor: width_fill_factor %}
        {% assign image_index = image_index | plus: 1 %}
      {% endif %}
      {% if fourth_image != blank %}
        {% render 'render-image-group-item', image: fourth_image, image_count: image_count, image_index: image_index, layout: layout, width_fill_factor: width_fill_factor %}
      {% endif %}
    {% else %}
      {% for image in images %}
        {% render 'render-image-group-item', image: image, image_count: image_count, image_index: forloop.index0, layout: layout, width_fill_factor: width_fill_factor %}
      {% endfor %}
    {% endif %}
  </div>
</div>
