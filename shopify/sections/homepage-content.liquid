{% liquid
  assign homepage_content = shop.metaobjects.homepage_content.default
  assign homepage_sections = blank
  assign about_blocks = section.settings.about_blocks
  assign scent_blocks = section.settings.scent_blocks
  assign process_blocks = section.settings.process_blocks
  assign studio_blocks = section.settings.studio_blocks
  assign about_fallback = blank
  assign scent_fallback = blank
  assign process_fallback = blank
  assign studio_fallback = blank

  if homepage_content
    assign homepage_sections = homepage_content.sections.value
    if homepage_sections == blank
      assign homepage_sections = homepage_content.sections
    endif
  endif

  for page_section in homepage_sections
    assign nav_label = page_section.nav_label.value | default: page_section.nav_label
    assign blocks = page_section.blocks.value
    if blocks == blank
      assign blocks = page_section.blocks
    endif

    case nav_label
      when 'ABOUT'
        assign about_fallback = blocks
      when 'SCENT'
        assign scent_fallback = blocks
      when 'PROCESS'
        assign process_fallback = blocks
      when 'STUDIO'
        assign studio_fallback = blocks
    endcase
  endfor

  if about_blocks == blank
    assign about_blocks = about_fallback
  endif
  if scent_blocks == blank
    assign scent_blocks = scent_fallback
  endif
  if process_blocks == blank
    assign process_blocks = process_fallback
  endif
  if studio_blocks == blank
    assign studio_blocks = studio_fallback
  endif

  assign background_placeholder = settings.background_placeholder_color | default: '#e7e4df'
%}

{% if about_blocks == blank and scent_blocks == blank and process_blocks == blank and studio_blocks == blank and homepage_content == blank %}
  <main class="shopify-onboarding">
    <div class="shopify-onboarding__inner">
      <h1>Homepage content is not set up yet.</h1>
      <p>Select content blocks in the theme editor or create the <code>homepage_content</code> metaobject entry with handle <code>default</code>.</p>
    </div>
  </main>
{% else %}
  <div class="magnetic-dango-root" data-page-shell style="--background-placeholder: {{ background_placeholder }};">
    <div class="magnetic-dango-background-layer" aria-hidden="true">
      {% if settings.background_image != blank %}
        {{
          settings.background_image
          | image_url: width: 1920
          | image_tag:
            class: 'magnetic-dango-background-image',
            widths: '640, 960, 1280, 1536, 1920',
            sizes: '(max-aspect-ratio: 1920/1140) 168.5vh, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: ''
        }}
      {% else %}
        <img
          class="magnetic-dango-background-image"
          src="{{ 'background-default.jpg' | asset_url }}"
          alt=""
          width="1920"
          height="1140"
          loading="eager"
          fetchpriority="high"
        >
      {% endif %}
    </div>

    <div class="magnetic-dango-foreground-layer">
      <svg data-magnetic-svg viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true">
        <path
          data-metaball-path
          class="metaball-path"
          fill="transparent"
          stroke="rgba(0, 0, 0, 0.25)"
          stroke-width="0.5"
          vector-effect="non-scaling-stroke"
        ></path>
      </svg>

      <div class="site-logo" data-site-logo role="img" aria-label="{{ shop.name | escape }}">
        {% if settings.logo_image != blank %}
          {{
            settings.logo_image
            | image_url: width: 360
            | image_tag:
              class: 'site-logo-image',
              widths: '120, 240, 360',
              sizes: '120px',
              loading: 'eager',
              alt: shop.name
          }}
        {% else %}
          {% render 'site-logo-svg' %}
        {% endif %}
      </div>

      <div class="left-nav" data-left-nav>
        <button type="button" class="left-nav-button" data-nav-button data-section-target="section-about">ABOUT</button>
        <button type="button" class="left-nav-button" data-nav-button data-section-target="section-scent">SCENT</button>
        <button type="button" class="left-nav-button" data-nav-button data-section-target="section-process">PROCESS</button>
        <button type="button" class="left-nav-button" data-nav-button data-section-target="section-studio">STUDIO</button>
        <button
          type="button"
          class="left-nav-button"
          data-nav-button
          data-section-target="section-contact"
        >
          CONTACT
        </button>
      </div>

      <div class="scrollable-text-container" data-scroll-container>
        <div class="page-content-wrapper" data-content-wrapper>
          {% render 'render-page-section', section_id: 'section-about', blocks: about_blocks %}
          {% render 'render-page-section', section_id: 'section-scent', blocks: scent_blocks %}
          {% render 'render-page-section', section_id: 'section-process', blocks: process_blocks %}
          {% render 'render-page-section', section_id: 'section-studio', blocks: studio_blocks %}

          {% liquid
            assign contact_heading = section.settings.contact_heading | default: homepage_content.contact_form_heading.value | default: homepage_content.contact_form_heading | default: 'Request & Purchase'
            assign contact_body = section.settings.contact_body
            assign contact_body_from_setting = false
            if contact_body != blank
              assign contact_body_from_setting = true
            endif
            if contact_body == blank
              assign contact_body = homepage_content.contact_body
            endif
            assign contact_image = section.settings.contact_image
            if contact_image == blank
              assign contact_image = homepage_content.contact_image.value | default: homepage_content.contact_image
            endif
          %}
          {% render 'contact-section', contact_heading: contact_heading, contact_body: contact_body, contact_body_from_setting: contact_body_from_setting, contact_image: contact_image %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Homepage Content",
  "settings": [
    {
      "type": "metaobject_list",
      "id": "about_blocks",
      "label": "About blocks",
      "metaobject_type": "content_block",
      "limit": 50
    },
    {
      "type": "metaobject_list",
      "id": "scent_blocks",
      "label": "Scent blocks",
      "metaobject_type": "content_block",
      "limit": 50
    },
    {
      "type": "metaobject_list",
      "id": "process_blocks",
      "label": "Process blocks",
      "metaobject_type": "content_block",
      "limit": 50
    },
    {
      "type": "metaobject_list",
      "id": "studio_blocks",
      "label": "Studio blocks",
      "metaobject_type": "content_block",
      "limit": 50
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Request & Purchase"
    },
    {
      "type": "richtext",
      "id": "contact_body",
      "label": "Contact body"
    },
    {
      "type": "image_picker",
      "id": "contact_image",
      "label": "Contact image"
    }
  ],
  "presets": [
    {
      "name": "Homepage Content"
    }
  ]
}
{% endschema %}
