{% liquid
  assign form_heading = section.settings.form_heading | default: 'Request & Purchase'
  assign desktop_image_offset_right = section.settings.desktop_image_offset_right | default: 24
  assign desktop_text_max_width = section.settings.desktop_text_max_width | default: 320
%}

<section
  id="section-contact"
  class="content-section content-section--contact"
  data-section-id="section-contact"
  data-nav-label="CONTACT"
>
  {% render 'contact-section',
    contact_heading: form_heading,
    contact_body: section.settings.contact_body,
    contact_body_from_setting: true,
    contact_image: section.settings.contact_image,
    desktop_image_offset_right: desktop_image_offset_right,
    desktop_text_max_width: desktop_text_max_width
  %}
</section>

{% schema %}
{
  "name": "Contact",
  "limit": 1,
  "settings": [
    {
      "type": "richtext",
      "id": "contact_body",
      "label": "Contact body"
    },
    {
      "type": "image_picker",
      "id": "contact_image",
      "label": "Contact image"
    },
    {
      "type": "range",
      "id": "desktop_image_offset_right",
      "label": "Desktop image offset right",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "desktop_text_max_width",
      "label": "Desktop text max width",
      "min": 280,
      "max": 340,
      "step": 4,
      "unit": "px",
      "default": 320
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Request & Purchase"
    }
  ],
  "presets": [
    {
      "name": "Contact"
    }
  ]
}
{% endschema %}
