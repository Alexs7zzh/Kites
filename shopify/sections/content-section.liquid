{% liquid
  assign nav_label = section.settings.section_label | strip | default: 'SECTION'
  assign section_id = 'section-' | append: nav_label | handleize | append: '-' | append: section.id
%}

{% if section.blocks.size > 0 %}
  <section
    id="{{ section_id }}"
    class="content-section"
    data-section-id="{{ section_id }}"
    data-nav-label="{{ nav_label | escape }}"
  >
    {% for block in section.blocks %}
      {% render 'render-block', block: block %}
    {% endfor %}
  </section>
{% endif %}

